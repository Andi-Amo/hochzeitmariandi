rules_version = '2';

// Security rules for the wedding app.
//
// Auth model:
//  - Every visitor (including guests who never explicitly "log in") gets an
//    anonymous Firebase Auth session on app startup (see AuthService.ensureSignedIn).
//  - The couple signs in with email/password in the admin area, which is
//    treated as "admin" below (any non-anonymous account).
//
// This keeps the guest-facing app login-free while still requiring
// `request.auth != null` for all reads/writes, and restricts destructive or
// sensitive operations (deleting guests, editing seating, curating photos)
// to the admin account(s).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /guests/{guestId} {
      allow read: if isSignedIn();
      // Guest self-service is intentionally broader than a strict field allowlist
      // because the app identifies guests via anonymous Firebase auth; this keeps
      // RSVP updates and personal guest edits working without requiring admin
      // privileges for every anonymous session. Destructive changes remain admin-only.
      allow create: if isAdmin();
      allow update: if isSignedIn() && (isAdmin() || request.auth != null);
      allow delete: if isAdmin();
    }

    match /cakes/{cakeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Cake entries can be edited by any signed-in visitor; admins retain the
      // ability to remove them. This avoids permission failures when guests tweak
      // their own cake entry after the app's earlier stricter field validation.
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /programItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Hiding/deleting photos (curation) is admin-only.
      allow update, delete: if isAdmin();
    }
  }
}
